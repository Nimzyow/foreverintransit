---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactBand from "../components/ContactBand.astro";
import PhotoSlot from "../components/PhotoSlot.astro";
import JapanOutlines from "../components/JapanOutlines.astro";
import ContentWidth from "../components/ContentWidth.astro";
import "../styles/globals.css";

const skills = [
  "Python",
  "TypeScript",
  "Django",
  "React · Next.js",
  "React Native",
  "GraphQL",
  "Postgres",
  "AWS",
  "Terraform",
  "Kubernetes",
];
---

<BaseLayout
  lang="en"
  title="Nima Soufiani — Full Stack Engineer"
  description="Full stack engineer in London. Ten years in — from an idea in a meeting to something running in production."
  alternateHref="/ja/"
  sakura
>
  <SiteHeader lang="en" />

  <main>
    <section class="hero">
      <JapanOutlines />
      <img
        class="sq hero-squirrel wave"
        src="/squirrel_wave.png"
        alt=""
        aria-hidden="true"
      />
      <div class="hero-rule"></div>
      <div class="hero-grid">
        <div>
          <div class="available">
            <span class="available-dot" aria-hidden="true"></span>
            <span class="available-label">AVAILABLE — CONTRACT / PERMANENT</span>
          </div>
          <h1 class="hero-name-en">Nima<br />Soufiani</h1>
          <p class="hero-lede">
            Full stack engineer, ten years in. I take things from an idea in a
            meeting to something running in production — and then keep making it
            better.
          </p>
          <p class="hero-meta">London · English, 日本語, فارسی</p>
        </div>
        <PhotoSlot src="/IMG_8965_nima.png" alt="Nima Soufiani" />
      </div>
    </section>

    <ContentWidth>
    <section class="section" id="work">
      <div class="section-label-row">
        <h2 class="section-label">Things I built</h2>
        <span class="section-kicker">BOTH LIVE · TAP FOR THE STORY</span>
      </div>
      <div class="project-grid">
        <ProjectCard
          href="/work/recommends"
          title="Recommends"
          subtitle="iOS · App Store"
          description="Dishes locals actually eat. One photo of one plate is enough to help the next person order right. I designed it, built it and shipped it on my own."
          stack="React Native · Python · Celery"
          cta="Read the story →"
          liveLabel="LIVE"
          media="recommends"
        />
        <ProjectCard
          href="/work/olympo"
          title="Olympo"
          subtitle="olympogov.lu"
          description="A professional network built for corporate boards rather than general careers — matching, applications and CSSF governance in one place."
          stack="TypeScript · Postgres · AWS"
          cta="Read the story →"
          liveLabel="LIVE"
          media="olympo"
          imageSrc="/olympo/dashboard.jpg"
          imageAlt="Olympo member dashboard"
        />
      </div>
    </section>

    <section class="section-split" id="about">
      <div>
        <h2 class="section-label" style="margin-bottom: 18px">Where I am now</h2>
        <p class="section-body">
          Software Engineer at Vocalink (Mastercard), modernising national
          payments infrastructure. I built an internal Python CLI that cut a
          migration from 700 hours to one, now used by Mastercard teams
          globally.
        </p>
        <p class="section-body">
          Before that, four years at Ripple Energy while it grew from 8 people
          to 35. I'm looking for work where I can own the technical direction.
        </p>
      </div>
      <div class="skills-with-squirrel">
        <img
          class="sq skills-squirrel"
          src="/squirrel_coding.png"
          alt=""
          aria-hidden="true"
        />
        <div>
          <h2 class="section-label" style="margin-bottom: 14px">
            What I reach for
          </h2>
          <div class="tag-cloud">
            {skills.map((skill) => <span class="tag">{skill}</span>)}
          </div>
        </div>
      </div>
    </section>

    <ContactBand
      lang="en"
      title="Need a senior engineer on the team?"
      subtitle="Contract or permanent. I reply to everything."
    />
    </ContentWidth>
  </main>
</BaseLayout>
