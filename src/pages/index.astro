---
import "../styles/globals.css";
---
<div class="min-h-screen flex flex-col items-center justify-center bg-[var(--color-primary)] text-[var(--color-accent)]">
  <h1 class="text-5xl font-bold mb-4 text-[var(--color-highlight)]">Hello, I'm Nima!</h1>
  <p class="text-lg mb-6 text-[var(--color-secondary)]">Welcome to my portfolio site.</p>
  <button
    class="px-6 py-3 rounded font-semibold transition bg-[var(--color-highlight)] text-[var(--color-dark)]"
  >
    Contact Me
  </button>
</div>