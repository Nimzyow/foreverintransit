        <p class="text-lg mb-12 text-[var(--color-accent)] leading-relaxed">
          Here are some of the projects I've built, from recommendation engines to diving platforms.
        </p>
        
        <div class="grid grid-cols-1 gap-6">
          <!-- Recommends.app -->
          <div class="bg-[var(--color-primary)] p-6 rounded-lg text-left">
            <h3 class="text-xl font-bold mb-3 text-[var(--color-highlight)]">Recommends.app</h3>
            <p class="text-[var(--color-accent)] mb-4">AI-powered recommendation platform for discovering personalized content and products.</p>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">React</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">AI/ML</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Node.js</span>
            </div>
          </div>

          <!-- Annai -->
          <div class="bg-[var(--color-primary)] p-6 rounded-lg text-left">
            <h3 class="text-xl font-bold mb-3 text-[var(--color-highlight)]">Annai</h3>
            <p class="text-[var(--color-accent)] mb-4">Cultural guide and travel companion app for authentic local experiences.</p>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Vue.js</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Travel</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Mobile</span>
            </div>
          </div>

          <!-- Scuba'd -->
          <div class="bg-[var(--color-primary)] p-6 rounded-lg text-left">
            <div class="flex items-center gap-3 mb-3">
              <img 
                src="/squirrel_scuba.png" 
                alt="Squirrel scuba diving" 
                class="w-8 h-8"
              />
              <h3 class="text-xl font-bold text-[var(--color-highlight)]">Scuba'd</h3>
            </div>
            <p class="text-[var(--color-accent)] mb-4">Dive logging and underwater exploration platform for scuba diving enthusiasts.</p>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Python</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Django</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">PostgreSQL</span>
            </div>
          </div>

          <!-- Olympia -->
          <div class="bg-[var(--color-primary)] p-6 rounded-lg text-left">
            <h3 class="text-xl font-bold mb-3 text-[var(--color-highlight)]">Olympia</h3>
            <p class="text-[var(--color-accent)] mb-4">Fitness tracking and training optimization platform for athletes and fitness enthusiasts.</p>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">React Native</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Fitness</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Analytics</span>
            </div>
