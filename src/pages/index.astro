        <h2 class="text-4xl font-bold mb-8 text-[var(--color-highlight)]">What I Can Build For You</h2>
        
        <div class="grid grid-cols-1 gap-6">
          <div class="bg-[var(--color-dark)] p-6 rounded-lg">
            <div class="text-4xl mb-4 text-center">📱</div>
            <h3 class="text-xl font-bold mb-4 text-[var(--color-highlight)] text-center">Mobile Apps</h3>
            <div class="space-y-2 text-[var(--color-accent)] text-center">
              <p>iPhone & Android apps</p>
              <p>Apple Watch apps</p>
              <p>Cross-platform solutions</p>
            </div>
          </div>

          <div class="bg-[var(--color-dark)] p-6 rounded-lg">
            <div class="text-4xl mb-4 text-center">💻</div>
            <h3 class="text-xl font-bold mb-4 text-[var(--color-highlight)] text-center">Websites & Web Apps</h3>
            <div class="space-y-2 text-[var(--color-accent)] text-center">
              <p>Business websites</p>
              <p>E-commerce stores</p>
              <p>Interactive web applications</p>
            </div>
          </div>

          <div class="bg-[var(--color-dark)] p-6 rounded-lg">
            <div class="text-4xl mb-4 text-center">🤖</div>
            <h3 class="text-xl font-bold mb-4 text-[var(--color-highlight)] text-center">Smart Solutions</h3>
            <div class="space-y-2 text-[var(--color-accent)] text-center">
