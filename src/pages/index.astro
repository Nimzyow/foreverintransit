            class="w-48 h-48 lg:w-56 lg:h-56 hover:scale-110 transition-transform duration-300 drop-shadow-xl"
          />
        </div>
        
        <!-- Right: Content -->
        <div class="flex-1">
          <h2 class="text-4xl lg:text-5xl font-bold mb-8 text-[var(--color-highlight)]">Featured Projects</h2>
          <p class="text-lg lg:text-xl mb-12 text-[var(--color-accent)] leading-relaxed">
            Here are some of the projects I've built, from recommendation engines to diving platforms.
