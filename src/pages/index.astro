            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Astro</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Portfolio</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Design</span>
            </div>
          </div>

          <!-- sneakynuts.com -->
          <div class="bg-[var(--color-primary)] p-6 rounded-lg text-left">
            <h3 class="text-xl font-bold mb-3 text-[var(--color-highlight)]">sneakynuts.com</h3>
