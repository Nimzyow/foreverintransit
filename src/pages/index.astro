                class="w-16 h-16"
              />
            </div>
            <h3 class="text-xl font-bold mb-4 text-[var(--color-highlight)]">Japan Experience</h3>
            <p class="text-[var(--color-accent)]">
              Immersed in Tokyo's tech scene, visited Kyoto's temples, and learned from Japanese craftsmanship and precision.
            </p>
          </div>

          <div class="bg-[var(--color-primary)] p-8 rounded-lg">
            <div class="flex justify-center mb-4">
              <img 
                src="/squirrel_muay_thai.png" 
                alt="Squirrel practicing Muay Thai" 
                class="w-16 h-16"
              />
            </div>
            <h3 class="text-xl font-bold mb-4 text-[var(--color-highlight)]">Muay Thai Training</h3>
            <p class="text-[var(--color-accent)]">
              Trained in authentic Thai gyms in Bangkok, learning discipline, focus, and the art of continuous improvement.
            </p>
