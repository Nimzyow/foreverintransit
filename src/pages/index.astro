            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Next.js</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">E-commerce</span>
              <span class="px-3 py-1 bg-[var(--color-dark)] text-[var(--color-secondary)] rounded-full text-sm">Stripe</span>
