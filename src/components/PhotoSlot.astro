---
interface Props {
  src?: string;
  alt?: string;
  label?: string;
}

const {
  src,
  alt = "Nima Soufiani",
  label = "Photo coming soon",
} = Astro.props;
---

{
  src ? (
    <div class="photo-slot has-photo">
      <img src={src} alt={alt} width="1086" height="1448" />
    </div>
  ) : (
    <div class="photo-slot" role="img" aria-label={label}>
      <span>{label}</span>
    </div>
  )
}
