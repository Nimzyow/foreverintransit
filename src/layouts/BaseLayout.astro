---
import SakuraFall from "../components/SakuraFall.astro";

interface Props {
  title: string;
  description: string;
  lang?: "en" | "ja";
  alternateHref?: string;
  /** Soft cherry-blossom fall. Defaults on for Japanese pages. */
  sakura?: boolean;
}

const {
  title,
  description,
  lang = "en",
  alternateHref,
  sakura = lang === "ja",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=Shippori+Mincho:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      alternateHref && (
        <link
          rel="alternate"
          hreflang={lang === "en" ? "ja" : "en"}
          href={alternateHref}
        />
      )
    }
  </head>
  <body class:list={["site-shell", lang === "ja" && "lang-ja"]}>
    {
      sakura && (
        <SakuraFall
          maxPetals={lang === "ja" ? 12 : 8}
          spawnEveryMs={lang === "ja" ? 1400 : 2000}
        />
      )
    }
    <slot />
  </body>
</html>
